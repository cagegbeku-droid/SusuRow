# SusuRow Environment Configuration

# Database (Supports SQLite locally or PostgreSQL/Supabase for production)
# Example Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./susurow.db

# JWT Authentication
JWT_SECRET_KEY=susurow-ghana-fintech-prod-secret-2026-key-replace-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# Ghana SMS Gateways (ARKESEL, HUBTEL, MNOTIFY, TERMII, TWILIO)
SMS_PROVIDER=ARKESEL
ARKESEL_API_KEY=your_arkesel_api_key_here
ARKESEL_SENDER_ID=SusuRow
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
MNOTIFY_API_KEY=
TERMII_API_KEY=

# Ghana Mobile Money Gateway (Paystack Ghana for MTN MoMo, Telecel Cash, AT Money)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
